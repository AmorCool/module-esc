{
  "$schema": "../../module.schema.json",
  "spec": "escape.module.v1",
  "id": "com.escapeos.airlift-poc",
  "name": "Airlift PoC",
  "icon": "bolt.horizontal.circle.fill",
  "accent": "purple",
  "version": "2.0.5",
  "versionCode": 1,
  "author": "EscapeOS Official",
  "description": "airlift 漏洞利用的调试与功能模块。自带原生 SwiftUI 界面（不依赖 webroot），通过宿主能力接口读写沙盒外文件、开关监督模式。",
  "notes": "需要宿主 v0.3.525+（备份页要读宿主回报的键数/当前状态与 AIR 副本；系统选项页靠宿主「读前让 cfprefsd 松手」才能读得到 Preferences）.沙盒外操作依赖 airlift 漏洞利用：普通文件（Caches / CallServices / Passes 等）读写可靠；「目录浏览」通过把整个目录临时搬进 Media 再搬回实现（有约 20~40 秒的缺位窗口，已拒绝一批危险祖先路径）. 备份页**不自动替你挑**哪一份是好的，只把键数/字节/时间摊开.",
  "category": "系统维护",
  "minHostVersion": "0.3.526",
  "distribution": "external",
  "requires": [
    "host.version",
    "fs.read",
    "fs.write",
    "sys.supervised.get",
    "sys.supervised.set",
    "airlift.air",
    "airlift.pull",
    "airlift.overwrite",
    "airlift.delete",
    "airlift.writeMany",
    "airlift.changes",
    "airlift.changes.clear",
    "airlift.backups",
    "airlift.restore",
    "plist.tweak",
    "apps.lookup",
    "afc.stat",
    "afc.list",
    "afc.read",
    "afc.write",
    "afc.delete",
    "afc.mkdir"
  ],
  "ui": {
    "style": "native",
    "view": "airlift-poc",
    "title": "Airlift PoC"
  },
  "actions": []
}
