{
  "$schema": "../../module.schema.json",
  "spec": "escape.module.v1",
  "id": "com.escapeos.airlift-poc",
  "name": "Airlift PoC",
  "icon": "bolt.horizontal.circle.fill",
  "accent": "purple",
  "version": "2.0.0",
  "versionCode": 1,
  "author": "EscapeOS Official",
  "description": "airlift 漏洞利用的调试与功能模块。自带原生 SwiftUI 界面（不依赖 webroot），通过宿主能力接口读写沙盒外文件、开关监督模式。",
  "notes": "需要宿主 v0.3.496+。沙盒外操作依赖 airlift 漏洞利用：可读写单个已知文件；「目录浏览」通过把整个目录临时搬进 Media 再搬回实现（有约 20~40 秒的缺位窗口，已拒绝一批危险祖先路径）。",
  "category": "系统维护",
  "minHostVersion": "0.3.519",
  "distribution": "external",
  "requires": [
    "host.version",
    "fs.read",
    "fs.write",
    "sys.supervised.get",
    "sys.supervised.set",
    "airlift.air",
    "airlift.pull",
    "airlift.overwrite",
    "afc.stat",
    "airlift.delete",
    "airlift.writeMany",
    "airlift.changes",
    "airlift.changes.clear",
    "airlift.backups",
    "airlift.restore",
    "plist.tweak",
    "apps.lookup"
,
    "afc.list",
    "afc.read",
    "afc.write",
    "afc.delete",
    "afc.mkdir"  ],
  "ui": {
    "style": "native",
    "view": "airlift-poc",
    "title": "Airlift PoC"
  },
  "actions": []
}
